{
  "manifest_version": 3,
  "name": "YouTube Search: Sort Loaded Results by Date",
  "version": "1.0.0",
  "description": "Adds a newest/oldest control for the YouTube search results already loaded in the page.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Newest YouTube Search" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/results*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
